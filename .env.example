# =============================================================================
# .env.example — ШАБЛОН ФАЙЛА С СЕКРЕТНЫМИ КЛЮЧАМИ
# =============================================================================
# Это ШАБЛОН. Скопируйте этот файл и переименуйте копию в ".env"
# (команда: cp .env.example .env), после чего впишите туда свои реальные
# ключи. Файл ".env" НИКОГДА не должен попадать в git — он уже добавлен
# в .gitignore, чтобы случайно не "утекли" ваши приватные ключи на GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM-провайдер для агентов CrewAI (мозг агентов).
# CrewAI по умолчанию использует LiteLLM, поэтому подходит ключ OpenAI,
# Anthropic (Claude), либо любого другого поддерживаемого провайдера.
# Ниже — пример для Anthropic Claude, который используется в crew.py.
# -----------------------------------------------------------------------------
# Ключ API от console.anthropic.com (создаётся в разделе "API Keys").
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Если вместо Claude вы хотите использовать модели OpenAI (GPT-4o и т.д.),
# впишите свой ключ сюда и переключите LLM в crew.py.
OPENAI_API_KEY=your_openai_api_key_here

# Ключ API от openrouter.ai (альтернативный доступ к Claude и другим моделям
# через единый OpenAI-совместимый эндпоинт). Чтобы LLM в crew.py использовал
# именно его, задайте ещё CREW_LLM_MODEL с префиксом "openrouter/", например
# "openrouter/anthropic/claude-sonnet-5".
OPENROUTER_API_KEY=your_openrouter_api_key_here
CREW_LLM_MODEL=openrouter/anthropic/claude-sonnet-5
# Лимит токенов в ответе модели — снижайте, если провайдер отвечает 402
# "insufficient credits" при маленьком балансе.
CREW_LLM_MAX_TOKENS=4000

# -----------------------------------------------------------------------------
# TELEGRAM (Telethon) — нужен для чтения сигналов из чата/канала.
# api_id и api_hash получаются на https://my.telegram.org -> "API development tools".
# -----------------------------------------------------------------------------
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash_here
# Номер телефона аккаунта, от имени которого Telethon будет читать сообщения
# (в международном формате, например +79991234567).
TELEGRAM_PHONE=+10000000000
# Имя/юзернейм или числовой ID Telegram-канала/чата, откуда парсятся сигналы.
TELEGRAM_SIGNAL_CHANNEL=@example_signals_channel

# -----------------------------------------------------------------------------
# БИРЖИ (CCXT) — ключи API для торговли фьючерсами.
# У каждой биржи свой личный кабинет, где создаются API-ключи с правами
# на торговлю (Trade). Права на вывод средств (Withdraw) включать НЕ нужно —
# это критично для безопасности бота.
#
# Сигналы канала называют биржи по-разному (LONG на одной, SHORT на
# другой), причём набор бирж РОТИРУЕТСЯ — не всегда одна и та же пара.
# Поэтому ключи задаются ПО ИМЕНИ БИРЖИ: <БИРЖА>_API_KEY / <БИРЖА>_API_SECRET
# (trade_tool.py сам подставляет нужную пару по имени биржи из сигнала,
# приведённому к верхнему регистру). Заполняйте только те биржи, на
# которых реально собираетесь торговать — остальные можно оставить как
# есть (сигналы по ним бот пропустит, честно сообщив об этом в отчёте, а
# НЕ откроет одну ногу спреда без другой).
#
# ВАЖНО: OURBIT в этом списке нет — она не поддерживается библиотекой
# CCXT в принципе, никакие ключи для неё делу не помогут.
# -----------------------------------------------------------------------------
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret

BITGET_API_KEY=your_bitget_api_key
BITGET_API_SECRET=your_bitget_api_secret
# Bitget, в отличие от большинства бирж, требует ещё и "passphrase"
# (задаётся при создании ключа в личном кабинете биржи).
BITGET_PASSPHRASE=your_bitget_passphrase

ASTER_API_KEY=your_aster_api_key
ASTER_API_SECRET=your_aster_api_secret

GATE_API_KEY=your_gate_api_key
GATE_API_SECRET=your_gate_api_secret

BINGX_API_KEY=your_bingx_api_key
BINGX_API_SECRET=your_bingx_api_secret

# В канале эта биржа называется "HLIQUID" — trade_tool.py сам транслирует
# это имя в "hyperliquid" (реальный ID биржи в CCXT), поэтому переменная
# окружения называется именно HYPERLIQUID_*.
HYPERLIQUID_API_KEY=your_hyperliquid_api_key
HYPERLIQUID_API_SECRET=your_hyperliquid_api_secret

# -----------------------------------------------------------------------------
# ПАРАМЕТРЫ ТОРГОВЛИ / РИСК-МЕНЕДЖМЕНТ
# -----------------------------------------------------------------------------
# Размер одной сделки в USDT (сколько ставим на каждую ногу спреда).
TRADE_SIZE_USDT=100
# Кредитное плечо (leverage), которое выставляется на бирже перед сделкой.
TRADE_LEVERAGE=3
# Режим "сухого прогона": True — ордера НЕ отправляются на биржу, а только
# логируются в консоль. Полезно для тестирования пайплайна без риска денег.
DRY_RUN=True
