# =============================================================================
# .env.example — ШАБЛОН ФАЙЛА С СЕКРЕТНЫМИ КЛЮЧАМИ
# =============================================================================
# Это ШАБЛОН. Скопируйте этот файл и переименуйте копию в ".env"
# (команда: cp .env.example .env), после чего впишите туда свои реальные
# ключи. Файл ".env" НИКОГДА не должен попадать в git — он уже добавлен
# в .gitignore, чтобы случайно не "утекли" ваши приватные ключи на GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM-провайдер для агентов CrewAI (мозг агентов).
# CrewAI по умолчанию использует LiteLLM, поэтому подходит ключ OpenAI,
# Anthropic (Claude), либо любого другого поддерживаемого провайдера.
# Ниже — пример для Anthropic Claude, который используется в crew.py.
# -----------------------------------------------------------------------------
# Ключ API от console.anthropic.com (создаётся в разделе "API Keys").
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Если вместо Claude вы хотите использовать модели OpenAI (GPT-4o и т.д.),
# впишите свой ключ сюда и переключите LLM в crew.py.
OPENAI_API_KEY=your_openai_api_key_here

# Ключ API от openrouter.ai (альтернативный доступ к Claude и другим моделям
# через единый OpenAI-совместимый эндпоинт). Чтобы LLM в crew.py использовал
# именно его, задайте ещё CREW_LLM_MODEL с префиксом "openrouter/", например
# "openrouter/anthropic/claude-sonnet-5".
OPENROUTER_API_KEY=your_openrouter_api_key_here
CREW_LLM_MODEL=openrouter/anthropic/claude-sonnet-5
# Лимит токенов в ответе модели — снижайте, если провайдер отвечает 402
# "insufficient credits" при маленьком балансе.
CREW_LLM_MAX_TOKENS=4000

# -----------------------------------------------------------------------------
# TELEGRAM (Telethon) — нужен для чтения сигналов из чата/канала.
# api_id и api_hash получаются на https://my.telegram.org -> "API development tools".
# -----------------------------------------------------------------------------
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash_here
# Номер телефона аккаунта, от имени которого Telethon будет читать сообщения
# (в международном формате, например +79991234567).
TELEGRAM_PHONE=+10000000000
# Имя/юзернейм или числовой ID Telegram-канала/чата, откуда парсятся сигналы.
TELEGRAM_SIGNAL_CHANNEL=@example_signals_channel
# Прослушивание сигналов из канала — можно отключить, оставив сканер
# рынка и уведомления рабочими (True — слушать канал, как обычно).
CHANNEL_SIGNALS_ENABLED=True

# -----------------------------------------------------------------------------
# БИРЖИ (CCXT) — ключи API для торговли фьючерсами.
# У каждой биржи свой личный кабинет, где создаются API-ключи с правами
# на торговлю (Trade). Права на вывод средств (Withdraw) включать НЕ нужно —
# это критично для безопасности бота.
#
# Сигналы канала называют биржи по-разному (LONG на одной, SHORT на
# другой), причём набор бирж РОТИРУЕТСЯ — не всегда одна и та же пара.
# Поэтому ключи задаются ПО ИМЕНИ БИРЖИ: <БИРЖА>_API_KEY / <БИРЖА>_API_SECRET
# (trade_tool.py сам подставляет нужную пару по имени биржи из сигнала,
# приведённому к верхнему регистру). Заполняйте только те биржи, на
# которых реально собираетесь торговать — остальные можно оставить как
# есть (сигналы по ним бот пропустит, честно сообщив об этом в отчёте, а
# НЕ откроет одну ногу спреда без другой).
#
# ВАЖНО: OURBIT в этом списке нет — она не поддерживается библиотекой
# CCXT в принципе, никакие ключи для неё делу не помогут.
# -----------------------------------------------------------------------------
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret

BITGET_API_KEY=your_bitget_api_key
BITGET_API_SECRET=your_bitget_api_secret
# Bitget, в отличие от большинства бирж, требует ещё и "passphrase"
# (задаётся при создании ключа в личном кабинете биржи).
BITGET_PASSPHRASE=your_bitget_passphrase

ASTER_API_KEY=your_aster_api_key
ASTER_API_SECRET=your_aster_api_secret

GATE_API_KEY=your_gate_api_key
GATE_API_SECRET=your_gate_api_secret

BINGX_API_KEY=your_bingx_api_key
BINGX_API_SECRET=your_bingx_api_secret

# В канале эта биржа называется "HLIQUID" — trade_tool.py сам транслирует
# это имя в "hyperliquid" (реальный ID биржи в CCXT), поэтому переменная
# окружения называется именно HYPERLIQUID_*.
HYPERLIQUID_API_KEY=your_hyperliquid_api_key
HYPERLIQUID_API_SECRET=your_hyperliquid_api_secret

# -----------------------------------------------------------------------------
# ПАРАМЕТРЫ ТОРГОВЛИ / РИСК-МЕНЕДЖМЕНТ
# -----------------------------------------------------------------------------
# Размер одной сделки в USDT (сколько ставим на каждую ногу спреда).
TRADE_SIZE_USDT=100
# Кредитное плечо (leverage), которое выставляется на бирже перед сделкой.
# Если биржа не разрешает его для конкретного символа, бот автоматически
# откатывается на максимально разрешённое значение (см.
# _set_leverage_with_fallback в trade_tool.py).
TRADE_LEVERAGE=1
# Переиспользовать живые соединения с биржами между сделками вместо
# создания нового на каждое действие — см. _bot_event_loop в trade_tool.py.
# False — мгновенный откат на старое поведение без правки кода.
TRADE_USE_PERSISTENT_CONNECTIONS=True
# После скольких РЕАЛЬНЫХ откатов подряд монета блокируется автоматически
# и перестаёт пытаться открыться, пока не разблокируете вручную (см.
# blocked_coins_store.py, файл blocked_coins.json).
BLOCKED_COINS_FAILURE_THRESHOLD=2
# Режим "сухого прогона": True — ордера НЕ отправляются на биржу, а только
# логируются в консоль. Полезно для тестирования пайплайна без риска денег.
DRY_RUN=True

# -----------------------------------------------------------------------------
# СКАНЕР РЫНКА (scanner.py) — автономный поиск спредов/фандинга через CCXT,
# независимо от сигналов Telegram-канала.
# -----------------------------------------------------------------------------
SCANNER_ENABLED=False
SCANNER_EXCHANGES=bybit,gate,bitget,mexc
SCANNER_INTERVAL_SECONDS=0.5
SCANNER_SPREAD_THRESHOLD_PERCENT=1.0
SCANNER_FUNDING_THRESHOLD_PERCENT=0.5
SCANNER_ALERT_COOLDOWN_SECONDS=1800
SCANNER_MAX_SANE_SPREAD_PERCENT=50.0
# Приоритетный диапазон спреда (%) для ПОРЯДКА попытки входа: если среди
# найденных за цикл связок есть спред в этом диапазоне — пробуем её первой;
# если нет — берём остальные найденные связки как обычно. Не меняет пороги
# входа (TEST_BATCH_MIN_SPREAD и т.п.), только порядок попытки.
SCANNER_PRIORITY_SPREAD_MIN=4.0
SCANNER_PRIORITY_SPREAD_MAX=6.0
# Минимальная ликвидность (объём за 24ч в USDT, на менее ликвидной из двух
# бирж связки) — монеты ниже полностью исключаются из поиска связок.
SCANNER_MIN_LIQUIDITY_USDT=50000.0
# Проверка истории схождения спреда по свечам — если спред пары бирж НИ
# РАЗУ не опускался до SCANNER_CONVERGENCE_MAX_SPREAD_PCT за последние
# SCANNER_CONVERGENCE_LOOKBACK_HOURS часов, монета пропускается (признак
# постоянного разрыва в котировках, а не временной возможности).
SCANNER_CONVERGENCE_LOOKBACK_HOURS=24
SCANNER_CONVERGENCE_MAX_SPREAD_PCT=2.0
# Спред должен опускаться до SCANNER_CONVERGENCE_MAX_SPREAD_PCT не когда-то
# давно, а НЕДАВНО (часов назад) — иначе монета пропускается, даже если
# формально "сходилась" где-то в начале окна поиска.
SCANNER_CONVERGENCE_RECENCY_HOURS=8.0
# Кэш результата проверки схождения на N секунд — самый тяжёлый сетевой
# этап пайплайна входа, одну и ту же связку часто проверяем повторно.
SCANNER_CONVERGENCE_CACHE_TTL_SECONDS=180.0
# Если история спреда НИ РАЗУ не опускалась туже этого жёсткого порога —
# монета считается изначально "широкой" (постоянный разрыв котировок), и
# вход в неё разрешается ТОЛЬКО при спреде >= SCANNER_WIDE_SPREAD_MIN_ENTRY_PCT.
SCANNER_TIGHT_CONVERGENCE_PCT=1.0
SCANNER_WIDE_SPREAD_MIN_ENTRY_PCT=15.0
# Монеты, для которых требование SCANNER_WIDE_SPREAD_MIN_ENTRY_PCT (15%+)
# действует ВСЕГДА, независимо от convergence-check.
SCANNER_FORCE_WIDE_SPREAD_COINS=
# Закрывать ЛЮБУЮ позицию сразу, как только чистая (net, с учётом комиссий)
# прибыль достигает этой суммы в USDT — не дожидаясь схождения спреда.
SCANNER_CLOSE_MIN_PROFIT_USDT=0.15
# Жёсткий потолок на один цикл сканирования (сек) — защита от зависания
# на зависшем сетевом вызове (см. scanner.py:run()).
SCANNER_CYCLE_TIMEOUT_SECONDS=45
# Монеты, заведомо не торгуемые на текущих демо/testnet-счетах — через запятую.
SCANNER_EXCLUDED_COINS=BNB,SAMSUNG,CL,HOOD,KORU,SNDK,CRCL,SPCX,DOT,PEPE
# Монеты (через запятую), для которых позиция закрывается СРАЗУ при
# net_pnl >= 0, не дожидаясь схождения спреда до TEST_BATCH_CLOSE_SPREAD_MAX
# — для "застрявших" позиций, чей спред между биржами не сходится (пусто
# по умолчанию — обычное поведение для всех монет не меняется).
SCANNER_BREAKEVEN_CLOSE_COINS=
# Пауза (сек) перед повторной попыткой ОТКРЫТЬ ту же монету после отказа
# (VWAP/пост-фактум проверка) — не про алерты, только про частоту реальных
# попыток входа при быстром SCANNER_INTERVAL_SECONDS.
SCANNER_ENTRY_RETRY_COOLDOWN_SECONDS=20.0
# РАЗОВОЕ исключение из правила "1 нога на биржу" — НЕ постоянная настройка,
# бот сам выключает её в памяти после первого успешного использования.
# По умолчанию False; включайте только по явной разовой просьбе пользователя.
SCANNER_BUSY_EXCHANGE_ONE_TIME_OVERRIDE=False

# ⚠️ Если True — находки сканера автоматически идут в исполнение (реальные
# проверки безопасности из trade_tool.py применяются как обычно). Включайте
# только осознанно. См. config.py.
AUTO_TRADE_ENABLED=False
# Размер одной ноги (USDT) для авто-сделок — отдельно от TRADE_SIZE_USDT.
AUTO_TRADE_AMOUNT_USDT=6.0
# Мин. спред (%) для РЕАЛЬНОГО входа сканера (обычно выше порога алерта).
AUTO_TRADE_MIN_SPREAD=3.0
# Максимум одновременно открытых позиций (канал + сканер вместе).
MAX_OPEN_POSITIONS=5

# Тестовая серия (test_batch.py) — открывает РОВНО N сделок, затем
# приостанавливает поиск новых связок и мониторит/закрывает только их,
# по завершении шлёт сводный отчёт. Независимо от AUTO_TRADE_ENABLED.
TEST_BATCH_MODE=False
TEST_BATCH_SIZE=15
TEST_BATCH_AMOUNT_USDT=100.0
TEST_BATCH_MIN_SPREAD=3.0
TEST_BATCH_CLOSE_SPREAD=0.2
# Верхняя граница диапазона закрытия (%) — закрываем, когда текущий спред
# опустился ДО этого значения (не обязательно до самого TEST_BATCH_CLOSE_SPREAD)
# И суммарный PnL уже положительный — главное прибыль, а не точное схождение.
TEST_BATCH_CLOSE_SPREAD_MAX=1.0
TEST_BATCH_MONITOR_INTERVAL_SECONDS=0.5
# Биржи, допустимые для тестовой серии (независимо от DEMO_TRADING_SUPPORTED
# в trade_tool.py) — добавляйте биржу сюда, только когда сами проверили,
# что связанный с ней ключ ведёт на виртуальный (demo) счёт.
TEST_BATCH_SAFE_EXCHANGES=bybit,gate,bitget
